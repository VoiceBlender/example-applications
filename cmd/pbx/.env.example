# VoiceBlender server base URL.
VOICEBLENDER_URL=http://localhost:8080/v1

# Redis connection URL (required). Extensions and trunks are persisted here.
REDIS_URL=redis://localhost:6379/0

# Management console listen address.
LISTEN_ADDR=:8091

# Extension Address-of-Record domain and SIP digest realm.
# Softphones register as sip:<username>@<PBX_DOMAIN>.
PBX_DOMAIN=pbx.local
# PBX_REALM defaults to PBX_DOMAIN if unset.
PBX_REALM=pbx.local

# Multi-tenant: the console is multi-tenant. Create a workspace (tenant + admin)
# at /signup; each workspace has its own extensions, trunks, dial plan, config,
# and softphone accounts. Extension numbers may repeat across tenants; the SIP
# username is auto-namespaced as "<tenant>-<number>" to stay globally unique.
#
# Optionally seed a default tenant + admin for local dev, as
# SEED_TENANT=<slug>:<name>:<admin-user>:<admin-pass> (skipped if it exists).
SEED_TENANT=acme:Acme:admin:letmein

# Cross-tenant superadmin (SUPERADMIN=<user>:<pass>). Sign in with these at
# /login to reach /admin, which manages every tenant's extensions and trunks.
# Leave unset to disable the superadmin.
SUPERADMIN=root:letmein

# Initial on-hold music URL — a global fallback applied to any tenant that hasn't
# set its own (per-tenant hold music is managed from each console's Config page,
# persisted in Redis). Must be a URL VoiceBlender can fetch (MP3).
# HOLD_MUSIC_URL=https://example.com/hold.mp3

# IVR greeting + TTS configuration (used for inbound trunk calls).
COMPANY_NAME=Acme Corp
TTS_VOICE=Rachel
TTS_PROVIDER=elevenlabs
# TTS_API_KEY=...            # optional if configured server-side


# Speech-to-text for dial-plan Gather nodes in "speech"/"both" input mode.
STT_PROVIDER=deepgram
STT_LANGUAGE=en
# STT_API_KEY=...           # falls back to DEEPGRAM_API_KEY; optional if configured server-side

# Codec preference order for answered legs, e.g. "opus,PCMA,PCMU".
# ANSWER_CODECS=

# Log every raw VSI frame (commands sent / events + replies received).
# On by default; set to 0/false/off to silence.
# VSI_LOG=1
