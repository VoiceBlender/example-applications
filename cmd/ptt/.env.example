# VoiceBlender server base URL.
VOICEBLENDER_URL=http://localhost:8080/v1

# Redis connection URL (required). Users, sessions, and rooms are persisted here.
REDIS_URL=redis://localhost:6379/0

# Web console listen address.
LISTEN_ADDR=:8092

# Application identifier. Every room this demo creates on VoiceBlender is tagged
# and namespaced with it, and the app ignores VSI events tagged by a different
# app. Set a distinct value per demo when several examples share one
# VoiceBlender instance (contact-centre / ivr / pbx / ptt).
APP_ID=ptt

# Log every raw VSI frame (commands sent / events + replies received).
# On by default; set to 0/false/off to silence.
# VSI_LOG=1
