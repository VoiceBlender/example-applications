# Configuration for the live interpreter example.
#
#   cp cmd/interpreter/.env.example cmd/interpreter/.env
#
# Only VOICEBLENDER_URL and the provider keys really matter; everything else has
# a working default.

# ── VoiceBlender ─────────────────────────────────────────────────────────────
VOICEBLENDER_URL=http://localhost:8080/v1
LISTEN_ADDR=:8093

# Tags the rooms and browser legs this app creates, and scopes the VSI events it
# acts on, so several examples can share one VoiceBlender instance.
APP_ID=interpreter

# Log every raw VSI frame. OFF by default here, unlike the other examples: two
# live transcribers are chatty — Flux alone emits a `stt.turn` update about
# every 200 ms per leg — and logging every frame buries everything else. Turn it
# on briefly to watch leg_tts_preflight fire while someone is still talking and
# leg_tts_commit land the instant they stop.
# VSI_LOG=1

# ── access ───────────────────────────────────────────────────────────────────
# One shared static credential guards the console. Leaving AUTH_PASSWORD empty
# DISABLES the login entirely — fine on localhost, reckless anywhere public,
# because every visitor who starts a session spends your STT/TTS budget.
# Only the person STARTING a call needs this. The link they share carries a
# per-session invite token, which admits the other person to that one
# conversation without an account.
AUTH_USERNAME=interpreter
AUTH_PASSWORD=

# ── session limits (spend controls) ──────────────────────────────────────────
# Two connected legs stream audio to the STT vendor continuously, billed by the
# minute, whether or not anyone is talking. A forgotten tab is therefore a meter
# left running, and these are what stop it. Go duration strings; 0 disables.

# No speech for this long → end the session. The one that actually saves money.
SESSION_IDLE_TIMEOUT=5m

# Hard ceiling on any one conversation, in case something keeps making noise
# into the microphone and "activity" never stops.
SESSION_MAX_DURATION=1h

# A link nobody opened, or one everyone has left → drop it.
SESSION_EMPTY_TIMEOUT=5m

# Not configurable, but worth knowing: on SIGINT/SIGTERM the app ends every live
# session before exiting, so stopping the container does not strand legs that
# would go on being transcribed at your expense.

# ── speech to text ───────────────────────────────────────────────────────────
# The transcriber is chosen PER PARTICIPANT, by the language they speak.
#
# deepgram_flux is preferred: it is the only provider that reports EAGER end of
# turn, the signal the whole low-latency design is built on. But it covers only
# ten languages — en es fr de hi ru pt ja it nl — and rejects the connection for
# anything else.
#
# speechmatics covers the rest (pl uk tr ko zh). With both keys set, an
# English<->Polish call runs BOTH engines at once: the English side keeps Flux's
# eager path, and only the Polish->English direction pays the extra turn of
# latency. Without SPEECHMATICS_API_KEY those five languages are simply not
# offered, so nobody can pick one that would transcribe nothing.
STT_PROVIDER=deepgram_flux
STT_FALLBACK_PROVIDER=speechmatics
DEEPGRAM_API_KEY=
SPEECHMATICS_API_KEY=
# STT_API_KEY stands in ONLY for STT_PROVIDER above. It deliberately does not
# cover the fallback: a provider counts as available when it has a key, so one
# generic key would advertise languages that then fail at the dial.
# STT_API_KEY=

STT_EAGER_EOT_THRESHOLD=0.7

# Turn detection. Unset leaves Deepgram's defaults: end a turn at 0.7 confidence,
# or after 5000 ms of SILENCE regardless of confidence.
#
# That silence timer resets whenever speech is detected, so a microphone picking
# up continuous sound — an open mic, or your speakers echoing the interpreted
# voice back when testing two tabs on one machine — keeps a single turn open
# indefinitely and NOTHING is ever interpreted. Use headphones; the app logs a
# warning when it sees a turn running for minutes.
#
# STT_EOT_THRESHOLD must be >= STT_EAGER_EOT_THRESHOLD (the app clamps it).
# STT_EOT_THRESHOLD=0.7
# STT_EOT_TIMEOUT_MS=5000

# ── text to speech ───────────────────────────────────────────────────────────
TTS_PROVIDER=elevenlabs
# Flash is the low-latency model and is multilingual, so one voice covers every
# language the app offers.
TTS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_API_KEY=
# TTS_API_KEY=                       # overrides ELEVENLABS_API_KEY

# Each participant picks a gender in the UI, and their words are spoken to the
# OTHER side in the matching voice — a man's words arriving in a woman's voice
# is jarring to sit through. These must be ElevenLabs voice IDs, not names.
#
# TTS_VOICE_DEFAULT is what someone who prefers not to say is heard in. There is
# no stock voice that is convincingly androgynous, so it simply defaults to the
# female one; set it to whatever suits you rather than reading meaning into that.
# TTS_VOICE_FEMALE=21m00Tcm4TlvDq8ikWAM    # Rachel
# TTS_VOICE_MALE=pNInz6obpgDQGcFmaJgB      # Adam
# TTS_VOICE_DEFAULT=21m00Tcm4TlvDq8ikWAM   # Rachel

# ── translation ──────────────────────────────────────────────────────────────
# VoiceBlender's STT providers transcribe but do not translate, so this hop
# lives in the app.
#   deepl  dedicated MT, roughly 80–150 ms for one utterance
#   none   passthrough — no key needed; you hear your own words read back, which
#          is enough to prove every other hop works
TRANSLATE_PROVIDER=deepl
DEEPL_API_KEY=
# Free-tier keys use api-free; paid keys use api.deepl.com.
DEEPL_URL=https://api-free.deepl.com/v2/translate
