# Deployment configuration for compose.yaml.
#
#   cp .env.example .env    # docker compose reads .env automatically
#   docker compose up -d --build
#
# The values below are the PUBLIC deployment: both apps on port 443, told apart
# by hostname, each with its own Let's Encrypt certificate.
#
#     https://ccdemo.voiceblender.org/   → contact-centre
#     https://talky.voiceblender.org/    → push-to-talk
#
# Before this works:
#   1. DNS A/AAAA records for BOTH names must point at this host.
#   2. Host ports 80 AND 443 must be reachable from the public internet.
#      Port 80 is not optional — Let's Encrypt uses it for the HTTP-01
#      challenge, and Caddy uses it to redirect http → https.
#      Do NOT set CADDY_HTTP_PORT/CADDY_HTTPS_PORT here: remapping them
#      breaks certificate issuance, because Let's Encrypt always connects
#      to the public 80/443.

# ── domains ──────────────────────────────────────────────────────────────────
# Each becomes a Caddy site on :443 with its own Let's Encrypt certificate,
# selected per-connection by SNI.
CADDY_DOMAIN=ccdemo.voiceblender.org
CADDY_PTT_DOMAIN=talky.voiceblender.org

# Address Let's Encrypt notifies if a renewal starts failing. Use a real one.
CADDY_ACME_EMAIL=admin@voiceblender.org

# While testing, point at the Let's Encrypt STAGING CA — same flow, untrusted
# certs, no rate limits. A handful of failed attempts against production will
# lock you out for a week. Comment out once it all works, then
# `docker compose down -v` to drop the staging certs and re-issue for real.
# CADDY_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# ── hold music ───────────────────────────────────────────────────────────────
# The URL VoiceBlender fetches the contact centre's hold music from. This MUST
# be the public HTTPS URL once CADDY_DOMAIN is set: with a real domain there is
# no catch-all site left on :80, so the old http://host.docker.internal/moh/…
# would match no site, 404, and hold music would silently stop working.
HOLD_MUSIC_URL=https://ccdemo.voiceblender.org/moh/new_music.mp3

# ── secrets ──────────────────────────────────────────────────────────────────
# CHANGE THESE. They gate the contact centre's supervisor and agent panels, and
# this deployment is on the public internet.
SUPERVISOR_PASSWORD=letmein
AGENT_PASSWORD=letmein

# ── optional ─────────────────────────────────────────────────────────────────
# Persist the contact centre's call log in Redis instead of memory.
# CALL_LOG_BACKEND=redis

# app_id keeps the two apps' events apart on the shared VoiceBlender. The
# defaults are fine; override only if you run several copies of one app.
# CC_APP_ID=contact-centre
# PTT_APP_ID=ptt

# Raw VSI frame logging for the ptt app (1 = on, the default; 0 = quiet).
# VSI_LOG=0
